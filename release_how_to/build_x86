#!/usr/bin/env bash
# 在宿主 x86_64（或其它原生架构）上使用本机编译器构建 Release
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
BUILD_DIR="${SCRIPT_DIR}/build-x86"
BUILD_TYPE="${BUILD_TYPE:-Release}"
JOBS="${JOBS:-$(getconf _NPROCESSORS_ONLN 2>/dev/null || echo 4)}"

echo "[build_x86] repo: ${REPO_ROOT}"
echo "[build_x86] out:  ${BUILD_DIR} (${BUILD_TYPE})"

cmake -S "${REPO_ROOT}" -B "${BUILD_DIR}" -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" "$@"
cmake --build "${BUILD_DIR}" -j"${JOBS}"

echo "[build_x86] done."
echo "  bin: ${BUILD_DIR}/bin"
echo "  lib: ${BUILD_DIR}/lib"
